      "rows": [
       {
        "0": {
         "cells": [],
         "cssClass": "",
         "cssId": "",
         "cssStyle": "",
         "label": "Customers Review Module",
         "name": "dnd_area-module-6",
         "params": {
          "child_css": {},
          "css": {},
          "css_class": "dnd-module",
          "heading_text": "<h2 class=\"animate_show\">What our customers say</h2>",
          "path": "../modules/custom-module/Customers Review Module",
          "repeater_group": [
           {
            "add_content": "<p><span dir=\"ltr\" role=\"presentation\">\"Flieber allows us to leverage technology to make demand </span><span dir=\"ltr\" role=\"presentation\">planning and forecasting more streamlined and efficient. As a </span><span dir=\"ltr\" role=\"presentation\">result, we have a less error prone process and have more time </span><span dir=\"ltr\" role=\"presentation\">to spend making strategic decisions vs. data clean-</span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">up/analysis.\"</span></p>",
            "client_name_and_job_title": {
             "client_name": "Wesley Way",
             "company_job_title": "VP of Operations"
            },
            "enable_client_detail": true,
            "logo_image": {
             "src": ""
            },
            "user_image": {
             "alt": "Box-1",
             "height": 350,
             "loading": "lazy",
             "max_height": 350,
             "max_width": 251,
             "size_type": "auto",
             "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/Flieber/images/Box-1.png",
             "width": 251
            }
           },
           {
            "add_content": "<p><span dir=\"ltr\" role=\"presentation\">\"Flieber is a game-changer for supply chain planning in e-</span><span dir=\"ltr\" role=\"presentation\">commerce companies. Its efficient consolidation of sales data </span><span dir=\"ltr\" role=\"presentation\">through its integrations not only simplifies decision-making but </span><span dir=\"ltr\" role=\"presentation\">also saves significant time. Their user-friendly interface </span><span dir=\"ltr\" role=\"presentation\">ensures easy navigation, making it a valuable tool for </span><span dir=\"ltr\" role=\"presentation\">streamlining operations and boosting productivity. Flieber is a </span><span dir=\"ltr\" role=\"presentation\">must-have for businesses looking to optimize their supply </span><span dir=\"ltr\" role=\"presentation\">chain processes.\"</span></p>",
            "client_name_and_job_title": {
             "client_name": "Sara Maya",
             "company_job_title": "Supply Chain Manager"
            },
            "enable_client_detail": true,
            "logo_image": {
             "src": ""
            },
            "user_image": {
             "alt": "Box",
             "height": 350,
             "loading": "lazy",
             "max_height": 350,
             "max_width": 250,
             "size_type": "auto",
             "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/Flieber/images/Box.png",
             "width": 250
            }
           },
           {
            "add_content": "<p><span dir=\"ltr\" role=\"presentation\">With Flieber, I could integrate the inventory position in </span><span dir=\"ltr\" role=\"presentation\">different locations and also have an accurate sales forecast </span><span dir=\"ltr\" role=\"presentation\">for multiple channels. As a result, it is much easier to plan and </span><span dir=\"ltr\" role=\"presentation\">replenish inventory. And stockouts are no more a problem. I </span><br role=\"presentation\"><span dir=\"ltr\" role=\"presentation\">love the real-time view of the entire supply chain operation: </span><span dir=\"ltr\" role=\"presentation\">what is transit, when will it arrive, and what to order or transfer. I</span><span dir=\"ltr\" role=\"presentation\">t completely changed my replenishment process.\"</span></p>",
            "client_name_and_job_title": {
             "client_name": "JP SantAnna",
             "company_job_title": "CEO"
            },
            "enable_client_detail": true,
            "logo_image": {
             "src": ""
            },
            "user_image": {
             "alt": "wesley",
             "height": 4096,
             "loading": "lazy",
             "max_height": 2000,
             "max_width": 1333.49609375,
             "size_type": "auto_custom_max",
             "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/Flieber/images/new-image/wesley.jpg",
             "width": 2731
            }
           },
           {
            "add_content": "<p><span dir=\"ltr\" role=\"presentation\">\"I had problems replenishing our inventories and Flieber is </span><span dir=\"ltr\" role=\"presentation\">helping me plan when and how many to order to avoid </span><span dir=\"ltr\" role=\"presentation\">stockout. I love how the team is very hands-on. Every time I </span><span dir=\"ltr\" role=\"presentation\">had an issue, they are always there to help. Also, the </span><span dir=\"ltr\" role=\"presentation\">forecasting is accurate making my inventory planning easier.\"</span></p>",
            "client_name_and_job_title": {
             "client_name": "Criselda S",
             "company_job_title": "Supply Chain Manager"
            },
            "enable_client_detail": true,
            "logo_image": {
             "src": ""
            },
            "user_image": {
             "alt": "users",
             "height": 225,
             "loading": "lazy",
             "max_height": 225,
             "max_width": 226,
             "size_type": "auto",
             "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/Flieber/images/users.png",
             "width": 226
            }
           },
           {
            "add_content": "<p>\"Before Flieber, we manually analyzed sales and guessed purchase quantities, which took days. Now, we efficiently forecast and order only what's needed, avoiding excess inventory.\"</p>",
            "client_name_and_job_title": {
             "client_name": "Sohail L",
             "company_job_title": "CEO"
            },
            "enable_client_detail": true,
            "logo_image": {
             "src": ""
            },
            "user_image": {
             "alt": "Operator Card-2",
             "height": 460,
             "max_height": 460,
             "max_width": 460,
             "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/Flieber/images/logo-images/Operator%20Card-2.png",
             "width": 460
            }
           },
           {
            "add_content": "<p><span dir=\"ltr\" role=\"presentation\">\"Flieber has replaced an extremely time intensive piece of our </span><span dir=\"ltr\" role=\"presentation\">work with better results. It helps me predict my mid to long </span><span dir=\"ltr\" role=\"presentation\">term demand and inventory replenishment needs. This is </span><span dir=\"ltr\" role=\"presentation\">immensely important due to my long lead times and complex </span><span dir=\"ltr\" role=\"presentation\">product portfolio due to multi-channel variation. It's great to </span><span dir=\"ltr\" role=\"presentation\">have a tool that automates so much of this process.\"</span></p>",
            "client_name_and_job_title": {
             "client_name": "James Kelly",
             "company_job_title": "Co-Founder"
            },
            "enable_client_detail": true,
            "logo_image": {
             "src": ""
            },
            "user_image": {
             "alt": "bryan",
             "height": 238,
             "loading": "lazy",
             "max_height": 238,
             "max_width": 251,
             "size_type": "auto",
             "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/Flieber/images/new-image/bryan.png",
             "width": 251
            }
           }
