         "label": "Two-Col-Content-Img",
         "name": "widget_1749706917812",
         "params": {
          "background_color": "#186DFF",
          "content": "<p>Flieber integrates with Amazon, Shopify, Walmart, 3PLs, wholesale partners, and more\u2014giving operators full control across regions, channels, and fulfillment models. Foresight AI (previously Inventoro) started as a basic DTC tool and now operates as a limited forecasting add-on inside Cin7, making it hard to grow with confidence as complexity increases.</p>",
          "css_class": "dnd-module",
          "heading": "Designed for focus, not bundled in bloat",
          "image_field": {
           "alt": "designed-for-focus",
           "height": 901,
           "loading": "lazy",
           "max_height": 451,
           "max_width": 485,
           "size_type": "auto_custom_max",
           "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/designed-for-focus.png",
           "width": 970
          },
          "layout": "image-left",
          "main_background_color": "#FFF",
          "module_id": 191281957771,
          "schema_version": 2,
          "subheading": "Flieber connects every part of your ops\u2014from DTC to wholesale",
          "text_color": "#FFF"
         },
         "rowMetaData": [],
