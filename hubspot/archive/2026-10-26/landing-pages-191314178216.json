         "cssStyle": "",
         "label": "Two-Col-Content-Img",
         "name": "widget_1749724825893",
         "params": {
          "background_color": "#CCD9DB",
          "button": {
           "text_field": "Book a Demo"
          },
          "content": "<p>You can start the same day and see real forecasts without needing a consultant.</p>\n<p>Netstock requires a sales call just to get a quote and takes weeks to implement with no trial option.</p>",
          "content_width": "415px",
          "css_class": "dnd-module",
