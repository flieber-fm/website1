 "footerHtml": "<script>\ndocument.querySelectorAll('.video-card').forEach(card => {\n  const video = card.querySelector('video');\n  // Click = open lightbox\n  card.addEventListener('click', () => {\n    const src = video.getAttribute('src');\n    openVideoLightbox(src);\n  });\n});\n\nfunction openVideoLightbox(src) {\n  const lightbox = document.createElement('div');\n  lightbox.className = 'video-lightbox';\n  lightbox.innerHTML = `\n    <button class=\"close-btn\" aria-label=\"Close\">&times;</button>\n    <video src=\"${src}\" autoplay controls playsinline></video>\n  `;\n  document.body.appendChild(lightbox);\n\n  // Close on click or escape\n  lightbox.querySelector('.close-btn').addEventListener('click', () => lightbox.remove());\n  lightbox.addEventListener('click', e => {\n    if (e.target === lightbox) lightbox.remove();\n  });\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') lightbox.remove();\n  });\n}\n</script>\n",
 "headHtml": "<style>\n.explainer-videos-new .carousel .video-card {\n    box-shadow: none;\n}\n.carousel .video-card .play-toggle {\n    left: 0;\n    transform: none;\n    top: 0;\n}\n.video-card {\n  position: relative;\n  overflow: hidden;\n  cursor: pointer;\n}\n\n/* No shadow, center icon */\n.video-card .play-toggle {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  border: none;\n  color: white;\n  font-size: 64px;\n  opacity: 0;\n  transition: opacity 0.3s ease;\n  z-index: 3;\n  pointer-events: none;\n}\n\n/* Hover effect */\n.video-card:hover .play-toggle {\n  opacity: 1;\n}\n\n/* When playing, hide icon (still shows on hover) */\n.video-card.playing .play-toggle {\n  opacity: 0;\n}\n.video-card.playing:hover .play-toggle {\n  opacity: 1;\n}\n\n/* Lightbox overlay */\n.video-lightbox {\n  position: fixed;\n  inset: 0;\n  background: rgba(0,0,0,0.85);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 9999;\n}\n.video-lightbox video {\n  max-width: 90%;\n  max-height: 80vh;\n}\n.video-lightbox .close-btn {\n  position: absolute;\n  top: 20px;\n  right: 30px;\n  background: none;\n  color: white;\n  border: none;\n  font-size: 32px;\n  cursor: pointer;\n}\n.content-logo-form-wrap > .right-form {\n  flex: 0 0 600px!important;\n}\n@media (max-width: 1390px) {\n    .content-logo-form-wrap > .right-form {\n       flex: 0 0 500px!important; \n    }\n  }\n  @media (max-width: 1074px) {\n    .content-logo-form-wrap > .right-form {\n       flex: 1!important; \n    }\n  }\n  @media (max-width: 767px) {\n    .content-logo-form-wrap {\n       display: block!important;\n  \t}\n  \t.content-logo-form-wrap > .right-form {\n       width: 500px;\n   \t   max-width: 100%;\n       margin: 50px auto;\n  \t}\n  }  \n</style>",
