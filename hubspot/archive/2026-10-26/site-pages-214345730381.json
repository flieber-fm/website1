 "footerHtml": "<script type=\"text/javascript\" src=\"//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js\"></script>\n\n<script>\n    $(document).ready(function() {\n        var $slider = $('.results_list');\n        var slickInitialized = false;\n\n        function manageSlider() {\n            var windowWidth = $(window).width();\n\n            if (windowWidth < 1200) {\n                if (!slickInitialized) {\n                    // 1. Mark original items so we know what to keep\n                    $slider.children('.result_list_item').addClass('original-item');\n\n                    // 2. Clone only the original items and append them\n                    $slider.children('.original-item').clone().removeClass('original-item').addClass('cloned-item').appendTo($slider);\n\n                    // 3. Initialize Slick\n                    $slider.slick({\n                        slidesToShow: 4, \n                       autoplay: true,\n                      autoplaySpeed: 6000,\n                        slidesToScroll: 1,\n                        infinite: true,\n                        dots: false,          \n                        arrows: true,\n                        responsive: [\n                            { breakpoint: 992, settings: { slidesToShow: 3 } },\n                            { breakpoint: 768, settings: { slidesToShow: 2 } },\n                            { breakpoint: 600, settings: { slidesToShow: 1 } }\n                        ]\n                    });\n                    slickInitialized = true;\n                }\n            } else {\n                if (slickInitialized) {\n                    // 1. Completely destroy Slick slider\n                    $slider.slick('unslick');\n\n                    // 2. Wipe out the mobile cloned items from the DOM\n                    $slider.children('.cloned-item').remove();\n                    $slider.children('.original-item').removeClass('original-item');\n\n                    slickInitialized = false;\n                }\n            }\n        }\n\n        manageSlider();\n\n        var resizeTimer;\n        $(window).on('resize', function() {\n            clearTimeout(resizeTimer);\n            resizeTimer = setTimeout(manageSlider, 100);\n        });\n    });\n</script>\n <script>\nlet lineMoveAdded = false;\nlet timer = null;\n\nsetInterval(function () {\n\n    const $section = $('.platform-ecomm-op-main-two');\n\n    // Active-1\n    if ($section.hasClass('active-1') && !lineMoveAdded) {\n\n        lineMoveAdded = true;\n\n        timer = setTimeout(function () {\n            $section.addClass('line-move');\n        }, 1000);\n    }\n\n    // Active-2\n    if ($section.hasClass('active-2')) {\n\n        $section.removeClass('line-move');\n\n        clearTimeout(timer);\n\n        // Allow next cycle\n        lineMoveAdded = false;\n    }\n\n    // Active-3\n    if ($section.hasClass('active-3')) {\n\n        $section.removeClass('line-move');\n\n        clearTimeout(timer);\n\n        // Allow next cycle\n        lineMoveAdded = false;\n    }\n\n}, 100);\n </script>",
