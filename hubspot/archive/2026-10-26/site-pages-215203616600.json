          "batch_col": "<p>Studio</p>",
          "blue_box_content": "<p>Every Monday, send a report of the products with stockout risk to my #operations and #marketing channels on Slack.</p>",
          "css_class": "dnd-module",
          "dynamic_left_content": [
           {
            "blue_box_content": "<p>Every Monday, send a report of the products with stockout risk to my #operations and #marketing channels on Slack.</p>",
            "grey_box_content": "<p><strong><em>\u2192</em></strong> A live dashboard tailored to your operation, used every day.</p>",
