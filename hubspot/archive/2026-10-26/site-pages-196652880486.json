      "rows": [
       {
        "0": {
         "cells": [],
         "cssClass": "",
         "cssId": "",
         "cssStyle": "",
         "label": "manage-work-module",
         "name": "widget_1758887492651",
         "params": {
          "css_class": "dnd-module",
          "left_panel": {
           "tile": [
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Configurations &amp; Parameters</h4>\n<p>Commerce never stands still. New products, discontinued products, new channels, change of warehouses \u2014 our team keeps all your configurations and parameters always up to date.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Data Loading</h4>\n<p>Flieber connects natively with many data sources, but even if you rely on spreadsheets or disconnected systems, our team makes sure all sales, inventory, and purchase order data is synced.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Advanced Forecasting</h4>\n<p>Our AI transformer forecasting models deliver a strong baseline. But reality is rarely perfect \u2014 so our team stays on top of forecasts, ensuring accuracy and incorporating future plans like promotions.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Anomaly Detection</h4>\n<p>Retail is unpredictable. The key is spotting risks early \u2014 stockouts, overstocks, sudden demand shifts. We flag anomalies and help you take quick action.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Replenishment Needs</h4>\n<p>We deliver replenishment recommendations on your schedule and in your preferred format, so you can approve purchases and transfers with confidence.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Reporting</h4>\n<p>Different teams need different insights. We create tailored recurring reports in your preferred format and frequency.</p>"
            }
           ],
           "tile_heading": "<h3>LITE Plan</h3>\n<p>The LITE Plan includes:</p>"
          },
          "manage_work_top_content": "<h2>How It Works</h2>\n<p>Flieber\u2019s Managed Services cover the full demand planning and inventory management workflow.</p>",
          "module_id": 196663980851,
          "right_panel": {
           "tile": [
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>POs &amp; TOs</h4>\n<p>Extracting, adjusting, and sending purchase/transfer orders is tedious and low-value. Our team does it for you.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Production Management</h4>\n<p>Consistent supplier follow-up is one of the most underrated drivers of success. We keep close contact at the cadence you want \u2014 so we\u2019re always proactive, instead of reactive.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Freight Management</h4>\n<p>From engaging freight forwarders to checking customs docs to coordinating trucking, our team handles the details so yours doesn\u2019t have to.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Inbound Shipments</h4>\n<p>For many brands, creating and managing FBA or 3PL shipments is a full-time job. For us, it\u2019s just part of daily operations.</p>"
            },
            {
             "check_icon": {
              "alt": "icon",
              "height": 34,
              "loading": "lazy",
              "max_height": 34,
              "max_width": 34,
              "size_type": "auto",
              "src": "https://5767502.fs1.hubspotusercontent-na1.net/hubfs/5767502/icon.svg",
              "width": 34
             },
             "tile_description": "<h4>Other Specific Needs</h4>\n<p>Most times, our team can also help with other special projects or specific needs. Just talk to us about your use cases.</p>"
            }
           ],
           "tile_heading": "<h3>FULL Plan</h3>\n<p>The FULL Plan goes further, including:</p>"
          },
          "schema_version": 2
         },
